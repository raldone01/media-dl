{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug with YT args",
      "cargo": {
        "args": [
          "build",
          "--bin=media-dl"
        ],
        "filter": {
          "name": "media-dl",
          "kind": "bin"
        }
      },
      "args": [
        "--media-library",
        "./tmp/media_library",
        "--cookies",
        "${env:HOME}/Downloads/cookies.txt",
        "https://music.youtube.com/watch?v=XqoanTj5pNY",
        "https://music.youtube.com/playlist?list=PLVbh6SVim2R0",
        "--audio-format",
        "mp3"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
